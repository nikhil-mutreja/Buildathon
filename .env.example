# ============================================================
# DevPilot - Environment Configuration
# ============================================================

# Application Execution Mode: 'real' or 'mock'
# If credentials are not provided, DevPilot gracefully defaults to mock mode.
APP_MODE=mock

# Swytchcode Execution Authority
# Set SWYTCHCODE_TOKEN for authenticated Swytchcode execution layer
SWYTCHCODE_TOKEN=

# GitHub Configuration
GITHUB_TOKEN=
GITHUB_REPO_OWNER=octocat
GITHUB_REPO_NAME=Hello-World

# Jira Configuration
JIRA_DOMAIN=https://your-company.atlassian.net
JIRA_EMAIL=dev@yourcompany.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=DEV

# Slack Configuration
SLACK_BOT_TOKEN=xoxb-your-token
SLACK_CHANNEL=C1234567890

# Optional LLM Provider (DevPilot provides built-in heuristic NLP when no LLM key is set)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
